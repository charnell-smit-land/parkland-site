# Keep the Cloudflare preview address out of Google; only parkland.consulting gets indexed
https://:project.pages.dev/*
  X-Robots-Tag: noindex

# Always check for fresh styles and images after an update
/assets/*
  Cache-Control: public, max-age=0, must-revalidate

# Internal check script, not a page
/checks/*
  X-Robots-Tag: noindex
